DISCORD_BOT_TOKEN=
# The only Discord server/guild where this bot is allowed to operate.
DISCORD_GUILD_ID=
# Optional release label. If blank, /health uses the current Git commit when available.
BOT_VERSION=

GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Discord Access
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

ALLOWED_EMAIL_DOMAINS=company.com

VERIFICATION_EXPIRY_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_SECONDS=60

SYNC_INTERVAL_MINUTES=15

# Local development default. Production should use /opt/offsight-bot/data/opsbot.db.
DATABASE_PATH=data/opsbot.db
