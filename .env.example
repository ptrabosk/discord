DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Discord Access
GOOGLE_FORMS_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

ALLOWED_EMAIL_DOMAINS=company.com

VERIFICATION_EXPIRY_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_SECONDS=60

SYNC_INTERVAL_MINUTES=15
FORM_SHEETS_RETRY_MINUTES=5
# Emergency Shift Release date range (timesheet adjustments always show the last 15 days).
FORM_DATE_PAST_DAYS=30
FORM_DATE_FUTURE_DAYS=30

WIW_REVIEW_CHANNEL_ID=
QUESTION_REVIEW_CHANNEL_ID=
CONCERN_REVIEW_CHANNEL_ID=
FEEDBACK_REVIEW_CHANNEL_ID=
FORM_ERROR_CHANNEL_ID=

LOG_LEVEL=INFO

# Agent reachouts (guides/reachouts/). Leave REACHOUT_SHEET_ID blank to keep the feature off.
REACHOUT_SHEET_ID=
REACHOUT_CHANNEL_CATEGORY_ID=
# Test mode is ON unless set to false. While on, only these people (agents AND leads) are messaged:
# verified work emails and/or Discord user IDs, comma-separated.
REACHOUT_TEST_MODE=true
REACHOUT_TEST_ALLOWED_USER_IDS=
# Overdue reminders and Discord retries only; Sheets are read and written only by /reachout_poll.
REACHOUT_POLL_SECONDS=60
REACHOUT_BATCH_SIZE=10
# Private channel for technical alerts; defaults to FORM_ERROR_CHANNEL_ID.
REACHOUT_ERROR_CHANNEL_ID=
